#!/usr/bin/env python3
"""A minimal /dev/log for the Lab Router. With no syslog daemon in the container, libc's syslog()
falls back to /dev/console, which is the student's console, so FRR's start-up messages
(watchfrr ... state -> up) were printed over the router prompt. This accepts syslog datagrams and
appends them to /var/log/syslog for staff instead."""
import os
import socket

PATH = "/dev/log"
try:
    os.unlink(PATH)
except FileNotFoundError:
    pass
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
s.bind(PATH)
os.chmod(PATH, 0o666)
with open("/var/log/syslog", "ab", buffering=0) as log:
    while True:
        msg = s.recv(8192)
        log.write(msg.rstrip(b"\0\n") + b"\n")
